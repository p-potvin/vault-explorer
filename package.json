{
  "name": "vault-explorer",
  "version": "3.0.0",
  "description": "Re-discover the joys of browsing your files on a christmas morning or a rainy tuesday at work.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "patchright": "^1.61.1"
  },
  "build": {
    "appId": "com.vaultwares.vaultexplorer",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "index.css",
      "themes.css",
      "themes.js",
      "js/**",
      "css/**",
      "src/**",
      "public/**",
      "powershell/**",
      "build/**",
      "python-scripts/**",
      "vault_explorer/**",
      "tools/**",
      "scripts/**",
      "vaultwares-themes/**",
      "node_modules/**",
      "!tools/models/*.nemo",
      "!tools/models/parakeet-tdt-0.6b-v3/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/builder-util/**",
      "!node_modules/electron-publish/**",
      "!node_modules/@electron/rebuild/**",
      "!node_modules/dmg-builder/**"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          ".env"
        ]
      }
    ],
    "asarUnpack": [
      "tools/**",
      "python-scripts/**",
      "vault_explorer/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "vault-explorer-setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-fetch": "^3.3.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}